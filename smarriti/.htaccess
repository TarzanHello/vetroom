# FurrFinder · sezione pubblica /smarriti/ (pagine generate da index.php)
# La stessa cartella va bene su vetroom.it e su furrfinder.com (vedi config.php).
DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
# Indirizzo unico del sito: https://www.vetroom.it (un solo passaggio 301)
RewriteCond %{HTTP_HOST} ^vetroom\.it$ [NC]
RewriteRule ^ https://www.vetroom.it%{REQUEST_URI} [L,R=301]
# Forza HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteBase /smarriti/
# La copia locale dei dati (se finisce qui) non si apre dal browser
RewriteRule ^cache/ - [F,L]
RewriteRule ^sitemap\.xml$ index.php?sitemap=1 [L,QSA]
# Tutto il resto (tranne i file veri: foglio di stile, script) va a index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php?p=$1 [L,QSA]
</IfModule>

# I file di servizio non si aprono dal browser
<FilesMatch "^(config|funzioni|guide)\.php$">
    Require all denied
</FilesMatch>
